{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://concesionaria-backend-rskz.onrender.com/:path*"
    },
    {
      "source": "/landing",
      "destination": "/landing/index.html"
    },
    {
      "source": "/landing/:path*",
      "destination": "/landing/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
